-- Auxiliares dos testes pgTAP. Incluído no início de cada teste com \ir; vive dentro
-- da transação do teste e desaparece no rollback.

create schema if not exists testes;
grant usage on schema testes to authenticated, anon;

-- Cria um usuário no Supabase Auth (o gatilho cria o perfil).
create or replace function testes.criar_usuario(p_email text, p_nome text default 'Pessoa de Teste')
returns uuid
language plpgsql
security definer
set search_path = ''
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (
    id, instance_id, aud, role, email, encrypted_password, email_confirmed_at,
    raw_app_meta_data, raw_user_meta_data, created_at, updated_at
  ) values (
    v_id, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated', p_email, '',
    now(), '{}', jsonb_build_object('nome', p_nome), now(), now()
  );
  return v_id;
end;
$$;

create or replace function testes.email(p_uid uuid)
returns text
language sql
security definer
set search_path = ''
as $$ select email from auth.users where id = p_uid $$;

-- Passa a agir como o usuário (papel authenticated + claims do JWT).
create or replace function testes.entrar(p_uid uuid)
returns void
language plpgsql
as $$
begin
  perform set_config(
    'request.jwt.claims',
    json_build_object('sub', p_uid, 'role', 'authenticated', 'email', testes.email(p_uid))::text,
    true
  );
  perform set_config('role', 'authenticated', true);
end;
$$;

-- Guarda/recupera identificadores entre trocas de usuário.
create or replace function testes.guardar(p_nome text, p_valor uuid)
returns uuid
language sql
as $$ select set_config('teste.' || p_nome, p_valor::text, true)::uuid $$;

create or replace function testes.id(p_nome text)
returns uuid
language sql
stable
as $$ select current_setting('teste.' || p_nome)::uuid $$;

-- Para cada tabela de public com tenant_id: quantas linhas do tenant informado o
-- usuário atual consegue ler (respeitando a RLS).
create or replace function testes.linhas_visiveis_do_tenant(p_tenant uuid)
returns table (tabela text, linhas bigint)
language plpgsql
as $$
declare
  t record;
begin
  for t in
    select c.table_name
      from information_schema.columns c
      join information_schema.tables tb
        on tb.table_schema = c.table_schema and tb.table_name = c.table_name
     where c.table_schema = 'public' and c.column_name = 'tenant_id' and tb.table_type = 'BASE TABLE'
     order by 1
  loop
    tabela := t.table_name;
    execute format('select count(*) from public.%I where tenant_id = $1', t.table_name)
      into linhas using p_tenant;
    return next;
  end loop;
end;
$$;

-- Executa um comando e devolve quantas linhas ele afetou (para provar "zero linhas").
create or replace function testes.linhas_afetadas(p_sql text)
returns bigint
language plpgsql
as $$
declare
  n bigint;
begin
  execute p_sql;
  get diagnostics n = row_count;
  return n;
end;
$$;

grant execute on all functions in schema testes to authenticated, anon;
